{
  "name": "codetools-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "build:verified": "npm run security:check && npm run check && npm run build && npm run smoke:production",
    "check": "npm run lint && npm run typecheck && npm test && npm run seo:check",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\"",
    "security:check": "npm audit --audit-level=high",
    "smoke:production": "node scripts/check-production.mjs",
    "seo:check": "node scripts/check-tool-content.mjs",
    "seo:live-check": "node scripts/check-live-seo.mjs"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "dependencies": {
    "@babel/parser": "8.0.8",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "prettier": "3.9.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^2.6.0",
    "terser": "5.51.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
